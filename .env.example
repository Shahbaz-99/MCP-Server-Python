# Copy to .env. Never commit real values.
MCP_HUB_LOG_LEVEL=INFO
MCP_HUB_ENABLED_PLUGINS=["sample"]

# HTTP mode
MCP_HUB_HTTP__HOST=127.0.0.1
MCP_HUB_HTTP__PORT=8000
MCP_HUB_HTTP__ALLOWED_ORIGINS=[]
MCP_HUB_HTTP__ALLOWED_HOSTS=["127.0.0.1:*","localhost:*"]

# OAuth (OIDC) resource server
MCP_HUB_AUTH__ENABLED=false
MCP_HUB_AUTH__ISSUER=https://idp.example.com/
MCP_HUB_AUTH__AUDIENCE=https://mcp.example.com/mcp
MCP_HUB_AUTH__RESOURCE_URL=https://mcp.example.com/mcp

# API-key store (hashes only)
MCP_HUB_AUTH__API_KEY_FILE=./data/keys.json

# Plugins
MCP_HUB_SAMPLE__FS_ROOTS=["./data/sandbox"]
MCP_HUB_GITHUB__TOKEN=
MCP_HUB_GITHUB__ALLOWED_REPOS=[]
